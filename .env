# ─────────────────────────────────────────────────────────────────
# Bmbtech — Environment Variables
# Generated from src/config.py (repo does not contain .env.example)
# ─────────────────────────────────────────────────────────────────

# ── Genius API Token (IMPORTANT) ──────────────────────────────────
# Get your free token at: https://genius.com/api-clients
# Without this, the "Genius" source (1 out of 6 sources) will not work
GENIUS_TOKEN=JUpV1A98IET2X6b1vfa5ObpaQuGuYKP8XQCnDpijBd1XBxciP9hIxB46dmqc0non

# ── Admin Security Key (IMPORTANT) ────────────────────────────────
# Your custom password to access /admin/cache/clear and /admin/cache/stats
# Code comment notes: "MUST be set on Render"
# Set a strong, unique string
ADMIN_KEY=@Bmbtech123

# ── Logging ──────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Caching ──────────────────────────────────────────────────────
# Time (seconds) to cache responses before fetching fresh data
CACHE_TTL=300

# Optional — directory where cache will be saved (leave blank, default is cache_data/ folder)
CACHE_DIR=

# ── YouTube Music lyrics source ─────────────────────────────────
# Optional — YouTube Music cookie to prevent blocks on source #4
YOUTUBE_COOKIE=

# ── LRCLIB (timestamped lyrics source) ──────────────────────────
# Has a default set already, change only if running your own mirror
LRCLIB_API_URL=https://lrclib.net/api/get

# ── Rate Limiting ────────────────────────────────────────────────
# Default: memory:// (does not persist after restart)
# For production, use Redis: redis://:password@redis-host:6379/0
RATE_LIMIT_STORAGE_URI=memory://
